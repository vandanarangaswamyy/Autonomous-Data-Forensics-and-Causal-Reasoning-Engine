# Local infrastructure credentials: generate values; never commit .env.
POSTGRES_USER=atlas
POSTGRES_DB=atlas
POSTGRES_PASSWORD=
NEO4J_PASSWORD=
ATLAS_ENVIRONMENT=development
ATLAS_LOG_LEVEL=INFO

POSTGRES_PORT=55432
REDIS_PORT=6379
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
KAFKA_PORT=9092

# Filled by scripts/bootstrap_simulator.py; keep credentials out of source control.
ATLAS_SIM_DATABASE_URL=
ATLAS_SIM_READER_URL=
ATLAS_SIM_READER_PASSWORD=
ATLAS_SIM_PRIVATE_DIR=.atlas-private
ATLAS_SIM_KAFKA_BOOTSTRAP=127.0.0.1:9092
ATLAS_SIM_KAFKA_TOPIC=atlas.simulator.events.v1
