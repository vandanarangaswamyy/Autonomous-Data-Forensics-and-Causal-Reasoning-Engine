        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "event_id": {
          "format": "uuid",
          "title": "Event Id",
          "type": "string"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "event_type": {
          "const": "pipeline.execution",
          "default": "pipeline.execution",
          "title": "Event Type",
          "type": "string"
        },
        "pipeline_id": {
          "title": "Pipeline Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "success",
            "degraded",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "input_rows": {
          "minimum": 0,
          "title": "Input Rows",
          "type": "integer"
        },
        "output_rows": {
          "minimum": 0,
          "title": "Output Rows",
          "type": "integer"
        },
        "quality": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Quality",
          "type": "object"
        }
      },
      "required": [
        "event_id",
        "run_id",
